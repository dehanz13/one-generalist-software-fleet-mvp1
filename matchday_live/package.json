{
  "name": "matchday-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Matchday Live: the live view of the One Generalist Software Fleet. A Vite + React page, a Vercel Functions API over Supabase, and a recorded demo.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "demo:from-legacy": "node scripts/demo-from-legacy.mjs ../../archives/sample-runs/ogsf-sample.db public/demo/matchday-demo.json"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "lucide-react": "1.59.0",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
