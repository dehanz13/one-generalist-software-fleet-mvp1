# OGSF environment. Copy to .env at the repository root and fill in.
# .env is never committed: `ogsf incorporate` adds it to .gitignore.
#
# WHICH KEYS YOU NEED DEPENDS ON YOUR ROSTER.
# Every `model:` in set_pieces/boardroom/club.config.yaml is written as
# provider/model-id. The provider half decides which key pi needs:
#   anthropic/claude-sonnet-5-5, anthropic/claude-haiku-4-5 -> ANTHROPIC_API_KEY
#   openai/gpt-5.3-codex, openai/gpt-5-mini                    -> OPENAI_API_KEY
# Point every player at one provider and you only need that provider's key.
# The fleet never reads these itself: pi does. A missing key shows up when
# that player runs, not at startup.

ANTHROPIC_API_KEY=
# Required with an Anthropic organization-level key; leave blank for a key
# already scoped to a workspace.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=

# Matchday Live on Vercel: watch this Mac's matches from anywhere.
# Mint a fleet token on the page (Connections → Fleet machines); it is shown
# once. Leave both blank to keep everything on this Mac.
CLUB_RELAY_URL=
CLUB_RELAY_TOKEN=

# Optional overrides
# CLUB_CONFIG=set_pieces/boardroom/club.config.yaml
# CLUB_MATCHLOG=set_pieces/clubhouse/match_log.db
# CLUB_MACHINE=                    # how this Mac is labelled on the page (default: host name)
# FOUNDER_NAME=                    # the founder's lane label (default: git user.name)
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
